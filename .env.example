# ─────────────────────────────────────────────────────────────────────────────
# Vishnu Mobile Shop — Example Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# The real .env is gitignored — never share it publicly.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Settings → API in your Supabase project)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Cloudinary (Dashboard → Settings → Upload Presets)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-upload-preset-name
CLOUDINARY_FOLDER=your-folder-name
